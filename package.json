{
  "name": "bmkrs.com",
  "version": "2.0.0",
  "description": "bmkrs: brands, digital products and practical AI (Next.js site in web/)",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix web",
    "dev:portal": "npm run dev --prefix apps/portal",
    "install:web": "npm ci --prefix web",
    "install:portal": "npm ci --legacy-peer-deps --prefix apps/portal",
    "build": "npm run build --prefix web",
    "build:portal": "npm run build --prefix apps/portal",
    "vercel-build": "npm run build",
    "lint": "npm run lint --prefix web",
    "start": "npm run start --prefix web",
    "seed:sanity": "npm run seed:sanity --prefix web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanepowel/bmkrs.com.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
