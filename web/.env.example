# Site
NEXT_PUBLIC_SITE_URL=https://www.bmkrs.com
NEXT_PUBLIC_NETWORK_PORTAL_URL=https://app.bmkrs.com
NEXT_PUBLIC_NETWORK_HIRE_URL=https://app.bmkrs.com/hire
NEXT_PUBLIC_NETWORK_JOIN_URL=https://app.bmkrs.com/join
NEXT_PUBLIC_MEMBER_LOGIN_URL=https://app.bmkrs.com/login

# Optional company details (shown in footer / legals when set).
# Use the real Companies House number and registered office only.
# Placeholder values (12345678, "replace before launch") are stripped and never published.
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_REGISTERED_ADDRESS=
NEXT_PUBLIC_CONTACT_PHONE=

# Analytics (loads only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-4GXGNXYMVL

# Sanity CMS (create at https://www.sanity.io/manage)
# Use project xwgymvao ("bmkrs") — not the duplicate laqqhrou project from early setup.
NEXT_PUBLIC_SANITY_PROJECT_ID=xwgymvao
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
# Generate: openssl rand -base64 32
# Then create webhook per web/sanity/webhook-config.md

# Optional: webhook for contact form (Slack, Zapier, etc.)
CONTACT_WEBHOOK_URL=
